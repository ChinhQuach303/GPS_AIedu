{
  "version": "1.0",
  "description": "Schema for GPS learning interaction logs.",
  "fields": [
    {
      "name": "submission_id",
      "type": "string",
      "required": true,
      "format": "UUID v4"
    },
    {
      "name": "student_id",
      "type": "string",
      "required": true,
      "format": "HS####"
    },
    {
      "name": "student_id_hash",
      "type": "string",
      "required": true,
      "format": "SHA-256(salt + student_id)"
    },
    {
      "name": "timestamp",
      "type": "string",
      "required": true,
      "format": "ISO-8601"
    },
    {
      "name": "gps_step",
      "type": "string",
      "required": true,
      "enum": ["G", "P", "S"]
    },
    {
      "name": "question_text",
      "type": "string",
      "required": true
    },
    {
      "name": "ai_response",
      "type": "string",
      "required": true
    },
    {
      "name": "topic",
      "type": "string",
      "required": false,
      "example": "Combinations"
    },
    {
      "name": "satisfaction",
      "type": "number",
      "required": true,
      "range": [1, 5]
    },
    {
      "name": "difficulty",
      "type": "number",
      "required": true,
      "range": [1, 5]
    },
    {
      "name": "notes",
      "type": "string",
      "required": false
    }
  ]
}
