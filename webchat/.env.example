# LLM provider
# - openai: uses OpenAI API (requires OPENAI_API_KEY)
# - ollama: uses local Ollama (no external quota)
# - vllm: uses local vLLM (requires OPENAI_API_KEY, OPENAI_BASE_URL)
LLM_PROVIDER=openai

# OpenAI (provider=openai)
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4o-mini
# Optional: use any OpenAI-compatible endpoint (e.g. Groq).
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT_MS=60000

# vLLM (provider=vllm)
# Note: vLLM uses the OpenAI API format, so it reuses OPENAI_API_KEY, OPENAI_MODEL, OPENAI_BASE_URL, OPENAI_TIMEOUT_MS
# OPENAI_API_KEY=vllm-not-needed
# OPENAI_MODEL=Qwen/Qwen2.5-Math-7B-Instruct
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_TIMEOUT_MS=60000

# Ollama (provider=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2-math:1.5b-instruct-q5_K_M

# GAS auto-log (Option B)
GAS_LOG_URL=https://script.google.com/macros/s/REPLACE_ME/exec
GAS_LOG_TOKEN=replace_me
