# LLM provider
# - openai: uses OpenAI API (requires OPENAI_API_KEY)
# - ollama: uses local Ollama (no external quota)
# - vllm: uses local vLLM (requires OPENAI_API_KEY, OPENAI_BASE_URL)
LLM_PROVIDER=vllm

# OpenAI / vLLM (provider=openai or vllm)
# For vLLM: use any dummy string for API_KEY, set BASE_URL to your vLLM server
OPENAI_API_KEY=token-vllm-optional
OPENAI_MODEL="Qwen/Qwen2.5-Coder-7B-Instruct-AWQ"
OPENAI_BASE_URL=http://localhost:8001/v1
# OPENAI_TIMEOUT_MS=60000

# Ollama (provider=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b-instruct-q4_K_M

# GAS auto-log (Option B)
GAS_LOG_URL=https://script.google.com/macros/s/AKfycbyngEQdvo_AxMDpRYKUPy67y8vgHpk0nq9z122CDTgEn2CsZHvjgPQa98pCToWnCsLg/exec
GAS_LOG_TOKEN=AKfycbyngEQdvo_AxMDpRYKUPy67y8vgHpk0nq9z122CDTgEn2CsZHvjgPQa98pCToWnCsLg

